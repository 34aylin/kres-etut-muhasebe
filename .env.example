# Veritabanı bağlantısı (host makinede başka bir Postgres 5432'yi kullanıyorsa
# docker-compose.yml'daki POSTGRES_HOST_PORT ile birlikte burayı da güncelleyin)
DATABASE_URL="postgresql://postgres:postgres@localhost:5544/kres_etut_muhasebe?schema=public"

# Auth.js
# `openssl rand -base64 32` ile üretin
AUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# Docker Compose - Postgres servis ayarları
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="kres_etut_muhasebe"
POSTGRES_HOST_PORT="5544"

# Docker Compose - host tarafında 3000 doluysa değiştirin (NEXTAUTH_URL ile eşleşmeli)
APP_HOST_PORT="3010"
