// Kreş & Etüt Merkezi Muhasebe — Faz 1: Veri Modeli ve Kimlik Doğrulama
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TenantType {
  KRES
  ETUT
}

/// Multi-tenant kök varlık: her kreş/etüt şubesi bir Tenant'tır.
model Tenant {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  /// Şubenin işletme türü — Kreş Yönetimi / Etüt Yönetimi. Uygulama genelinde
  /// etiket/terminoloji ve kayıt akışı bu alana göre şekillenir.
  type      TenantType @default(KRES)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  users        User[]
  parents      Parent[]
  students     Student[]
  enrollments  Enrollment[]
  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
  charges      Charge[]
  feePlans     FeePlan[]
  auditLogs    AuditLog[]

  @@map("tenants")
}

enum UserRole {
  ADMIN
  ACCOUNTANT
  TEACHER
}

model User {
  id                  String    @id @default(cuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                String
  email               String
  passwordHash        String
  role                UserRole  @default(TEACHER)
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  auditLogs AuditLog[]

  // Email global olarak benzersizdir: bir kullanıcı hesabı tek bir tenant'a
  // aittir ve girişte tenant seçimine gerek kalmaz (email + şifre yeterli).
  @@unique([email])
  @@index([tenantId])
  @@map("users")
}

model Parent {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  phone      String?
  email      String?
  nationalId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  students     StudentParent[]
  transactions Transaction[]
  charges      Charge[]
  feePlans     FeePlan[]

  @@index([tenantId])
  @@map("parents")
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
}

model Student {
  id        String        @id @default(cuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  birthDate DateTime?
  status    StudentStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  parents      StudentParent[]
  enrollments  Enrollment[]
  transactions Transaction[]
  charges      Charge[]
  feePlans     FeePlan[]

  @@index([tenantId])
  @@map("students")
}

enum ProgramType {
  KRES
  ETUT
}

/// Öğrencinin bir programa (kreş/etüt) kaydı: hangi tarihte başladığı ve durumu.
model Enrollment {
  id        String        @id @default(cuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId String
  student   Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  program   ProgramType
  startDate DateTime
  endDate   DateTime?
  status    StudentStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([tenantId])
  @@index([studentId])
  @@map("enrollments")
}

/// Öğrenci-Veli çoktan çoğa ilişkisi (kardeş / birden fazla veli desteği).
model StudentParent {
  id        String  @id @default(cuid())
  tenantId  String
  studentId String
  parentId  String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent    Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  relation  String? // örn. "anne", "baba", "vasi"

  @@unique([studentId, parentId])
  @@index([tenantId])
  @@map("student_parents")
}

// ---------------------------------------------------------------------------
// Faz 3 — Hesap Planı ve Gelir/Gider Modülü
// ---------------------------------------------------------------------------

enum AccountType {
  CASH // Kasa
  BANK // Banka Hesabı
}

/// Nakit/banka hesapları (basit hesap planı). Bakiye burada saklanmaz;
/// ilişkili Transaction kayıtlarından anlık olarak hesaplanır.
model Account {
  id        String      @id @default(cuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  type      AccountType
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  transactions Transaction[]

  @@index([tenantId])
  @@map("accounts")
}

enum CategoryType {
  INCOME
  EXPENSE
}

/// Gelir/gider alt kategorileri (Aidat Geliri, Kira Gideri vb.).
model Category {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  type      CategoryType
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  transactions Transaction[]
  charges      Charge[]
  feePlans     FeePlan[]

  @@index([tenantId])
  @@map("categories")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
}

/// Gerçekleşen gelir/gider hareketi (kasa/banka hesabına yansıyan nakit hareketi).
model Transaction {
  id            String          @id @default(cuid())
  tenantId      String
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type          TransactionType
  amount        Decimal         @db.Decimal(12, 2)
  date          DateTime
  accountId     String
  account       Account         @relation(fields: [accountId], references: [id])
  categoryId    String?
  category      Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  studentId     String?
  student       Student?        @relation(fields: [studentId], references: [id], onDelete: SetNull)
  parentId      String?
  parent        Parent?         @relation(fields: [parentId], references: [id], onDelete: SetNull)
  chargeId      String?
  charge        Charge?         @relation(fields: [chargeId], references: [id], onDelete: SetNull)
  paymentMethod PaymentMethod
  description   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([tenantId])
  @@index([accountId])
  @@index([chargeId])
  @@map("transactions")
}

/// Veliye/öğrenciye yüklenen borç (tahakkuk). Kalan bakiye, ilişkili
/// Transaction (tahsilat) kayıtlarından anlık olarak hesaplanır.
model Charge {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId   String?
  student     Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)
  parentId    String
  parent      Parent    @relation(fields: [parentId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  feePlanId   String?
  feePlan     FeePlan?  @relation(fields: [feePlanId], references: [id], onDelete: SetNull)
  amount      Decimal   @db.Decimal(12, 2)
  dueDate     DateTime
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  payments Transaction[]

  @@index([tenantId])
  @@index([parentId])
  @@index([studentId])
  @@map("charges")
}

/// Taksitli/tekrarlayan ücret planı (örn. "10 taksit x 500 TL aylık aidat").
/// Oluşturulduğunda otomatik olarak `installmentCount` adet Charge üretir.
model FeePlan {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId         String
  student           Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentId          String
  parent            Parent    @relation(fields: [parentId], references: [id], onDelete: Cascade)
  categoryId        String?
  category          Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name              String
  installmentAmount Decimal   @db.Decimal(12, 2)
  installmentCount  Int
  startDate         DateTime
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  charges Charge[]

  @@index([tenantId])
  @@map("fee_plans")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
}

// ---------------------------------------------------------------------------
// Platform Yönetimi — tenant'lardan tamamen bağımsız üst-seviye hesaplar.
// Bu model kasıtlı olarak Tenant'a bağlı değildir ve `forTenant()` tenant
// izolasyonunun (src/lib/tenant-db.ts) kapsamına girmez.
// ---------------------------------------------------------------------------

model PlatformAdmin {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("platform_admins")
}

/// Kritik işlemlerin izlenebilirliği (Faz 5'te genişletilecek).
model AuditLog {
  id         String      @id @default(cuid())
  tenantId   String
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     AuditAction
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@index([tenantId])
  @@map("audit_logs")
}
